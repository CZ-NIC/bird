# Where Gitlab files reside
gs := $(SOURCEDIR)/gitlab/

# Python venv craziness
VPYTHON = VIRTUAL_ENV=$(1) PATH="$(1)/bin:$$PATH" $(1)/bin/python3
VPIP = VIRTUAL_ENV=$(1) PATH="$(1)/bin:$$PATH" $(1)/bin/pip3
VRUN = VIRTUAL_ENV=$(1) PATH="$(1)/bin:$$PATH" $(2)

GITLAB_VENV ?= $(BUILDDIR)/gitlab-venv
$(GITLAB_VENV): INSTALL_PACKAGES := jinja2 pyaml

# Gitlab CI tests
.gitlab-ci.yml: $(gs)pipeline.py $(gs)template.yml.j2 $(gs)data.yml.j2
	$(if $(VENV),$(MAKE) $(GITLAB_VENV))
	$(if $(VENV),$(call VPYTHON,$(GITLAB_VENV)),python3) $^ > $@
	@if grep -n '	' $@; then echo "Found a tab in yaml output!"; false; fi

gitlab-ci: .gitlab-ci.yml gitlab-docker

$(BUILDDIR)/%-venv:
	mkdir -p $(dir $@)
	python3 -m venv $@
	$(call VPIP,$@) install $(INSTALL_PACKAGES)

clean::
	rm -rf $(GITLAB_VENV)

ifneq ($(strip $(if $(MAKECMDGOALS),$(filter $(gs)%Dockerfile $(gs)docker.mk gitlab-docker gitlab-ci,$(MAKECMDGOALS)),)),)

# Dockerfile build, autogenerated
$(gs)docker/%/Dockerfile: $(gs)pipeline.py $(gs)Dockerfile.j2 $(gs)data.yml.j2
	$(if $(VENV),$(MAKE) $(GITLAB_VENV))
	mkdir -p $(dir $@)
	$(if $(VENV),$(call VPYTHON,$(GITLAB_VENV)),python3) $^ target=$* > $@

$(gs)docker.mk: $(gs)pipeline.py $(gs)docker.mk.j2 $(gs)data.yml.j2
	$(if $(VENV),$(MAKE) $(GITLAB_VENV))
	$(if $(VENV),$(call VPYTHON,$(GITLAB_VENV)),python3) $^ > $@

include $(gs)docker.mk

endif

NOTARGETGOALS += $(filter $(gs)% $(GITLAB_VENV),$(MAKECMDGOALS))
NOTARGETGOALS += gitlab-docker gitlab-ci
.PHONY: gitlab-docker gitlab-ci

